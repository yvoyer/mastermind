{% extends 'base.html.twig' %}

{% block title %}Mastermind{% endblock %}

{% block stylesheets %}
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet">
    <style>
        :root {
            --panel-bg: rgba(18, 22, 29, .88);
            --panel-border: rgba(255, 255, 255, .16);
            --accent: #39ff88;
            --accent-soft: rgba(57, 255, 136, .18);
            --text-muted-console: #a8b3bf;
        }

        body {
            min-height: 100vh;
            background:
                radial-gradient(circle at 20% 15%, rgba(57, 255, 136, .12), transparent 26rem),
                radial-gradient(circle at 80% 75%, rgba(48, 162, 255, .12), transparent 24rem),
                linear-gradient(135deg, #090c10 0%, #161b22 52%, #0b1015 100%);
            color: #f4f7fb;
            font-family: var(--bs-font-monospace);
        }

        .console-shell {
            min-height: 100vh;
            display: grid;
            place-items: center;
            padding: 2rem 1rem;
        }

        .console-panel {
            width: min(100%, 34rem);
            border: 1px solid var(--panel-border);
            border-radius: .5rem;
            background: var(--panel-bg);
            box-shadow: 0 1rem 3.5rem rgba(0, 0, 0, .45);
            overflow: hidden;
        }

        .console-header {
            border-bottom: 1px solid var(--panel-border);
            padding: 1.5rem;
            text-align: center;
        }

        .console-title {
            letter-spacing: 0;
            font-weight: 800;
            text-transform: uppercase;
        }

        .console-subtitle {
            color: var(--text-muted-console);
        }

        .console-menu {
            padding: 1rem;
        }

        .console-option {
            display: flex;
            align-items: center;
            justify-content: space-between;
            min-height: 3.75rem;
            border: 1px solid transparent;
            border-radius: .35rem;
            color: #f4f7fb;
            text-decoration: none;
            text-transform: uppercase;
            font-weight: 700;
            padding: 0 1rem;
            transition: background-color .16s ease, border-color .16s ease, color .16s ease;
        }

        .console-option::before {
            content: ">";
            color: transparent;
            margin-right: .75rem;
        }

        .console-option::after {
            content: "";
            width: .5rem;
            height: .5rem;
            border-radius: 50%;
            background: var(--text-muted-console);
        }

        .console-option:hover,
        .console-option:focus-visible {
            background: var(--accent-soft);
            border-color: rgba(57, 255, 136, .55);
            color: var(--accent);
            outline: none;
        }

        .console-option:hover::before,
        .console-option:focus-visible::before {
            color: var(--accent);
        }

        .console-option:hover::after,
        .console-option:focus-visible::after {
            background: var(--accent);
            box-shadow: 0 0 1rem var(--accent);
        }
    </style>
{% endblock %}

{% block body %}
    <main class="console-shell">
        <section class="console-panel" aria-labelledby="welcome-title">
            <header class="console-header">
                <p class="console-subtitle mb-2">Welcome to</p>
                <h1 id="welcome-title" class="console-title display-5 mb-0">Mastermind</h1>
            </header>

            <nav id="welcome-menu"
                 class="console-menu d-grid gap-2"
                 aria-label="Main menu"
            >
                <a class="console-option" href="#">New Game</a>
                <a class="console-option" href="#">Load Game</a>
                <a class="console-option" href="#">Credits</a>
                <a class="console-option" href="#">Rules</a>
            </nav>
        </section>
    </main>
{% endblock %}
